# Copy this file to .env and fill in your own credentials.
# LLM service: replace the endpoint and model names for your account.
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-dashscope-api-key
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.2
ITEM_MODEL=qwen-flash
VL_MODEL=your-vision-model
MODEL=qwen-flash

# MinerU PDF parsing
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-api-token

# Local embedding model; use the path printed by the download script.
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=1
EMBEDDING_DIM=1024

# Milvus
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# Search and rerank; the MCP transport must match /mcp.
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落

# Relative to the project root when the services are started.
DATA_BASED_ROOT_DIR=data
